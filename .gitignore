# Commit: src/, server/, eval/, scripts/, lean docs/, manifest.json, package.json
# Never commit: dist/, node_modules/, Chrome profiles, editor/agent folders

# macOS junk
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated Load-unpacked root
dist/

# Packed Chrome extension + private signing key (never commit)
*.crx
*.pem

# Secrets / local Chrome profile
.env
.env.local
.env.*
.venv/
.chrome-demo-profile/

# Local agent / editor / graph (not the extension)
.agents/
.cursor/
.gstack/
.opencode/
graphify-out/
.graphify_detect.json
.graphifyignore
engineers/
AGENTS.md
CLAUDE.md
opencode.json

# Local E2E artifacts
eval/harness/.tp08-e2e-last.json

# Backups / patches
*.bak
*.bak-*
src/vendor/*.bak*

# Editors
.vscode/
.idea/
